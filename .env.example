# Safe to expose: identifies the Supabase project and applies RLS as anon/authenticated.
NEXT_PUBLIC_SUPABASE_URL=https://qizcujjcqzekzoneryxp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_URL=https://qizcujjcqzekzoneryxp.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_ROTATED_SERVER_SECRET
SUPABASE_JWKS_URL=https://qizcujjcqzekzoneryxp.supabase.co/auth/v1/.well-known/jwks.json

# Keep database credentials in local/deployment secrets, never in this file.
DATABASE_URL=YOUR_TRANSACTION_POOLER_URL
DIRECT_URL=YOUR_SESSION_POOLER_URL

NEXT_PUBLIC_APP_URL=https://bhawani-hardware.vercel.app

# Enable only after hosted Supabase Phone Auth uses Twilio/Twilio Verify with an approved WhatsApp sender.
NEXT_PUBLIC_WHATSAPP_OTP_ENABLED=false
