# Safe to expose: identifies the Supabase project and applies RLS as anon/authenticated.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=only_for_trusted_server_maintenance_if_required

NEXT_PUBLIC_APP_URL=http://localhost:3000
